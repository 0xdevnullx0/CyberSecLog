# ─── Anthropic / Claude ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── AlienVault OTX (free at https://otx.alienvault.com) ──────────────────────
OTX_API_KEY=your_otx_api_key_here

# ─── Email Delivery ────────────────────────────────────────────────────────────
# SMTP settings (Gmail example – use an App Password, not your account password)
EMAIL_SMTP_HOST=smtp-relay.brevo.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=a4b1f2001@smtp-brevo.com
EMAIL_PASSWORD=xsmtpsib-c239b52565866ea0588f8b2aa63a9ae90f00c922fa0c11d5db790fd02fce33ea-ARbLlaH5h3RUjCxG
# Comma-separated list of recipients
EMAIL_TO=Sharath.rt@gmal.com

# Optional subject-line prefix
EMAIL_SUBJECT_PREFIX=[CyberThreat Briefing]

# ─── Schedule ──────────────────────────────────────────────────────────────────
# Daily briefing time (24-hour clock, UTC by default)
BRIEFING_HOUR=7
BRIEFING_MINUTE=0
BRIEFING_TIMEZONE=UTC

# ─── Collection Windows ────────────────────────────────────────────────────────
# How many days back to look for new intelligence (1 = last 24 h)
NVD_DAYS_BACK=1
NEWS_DAYS_BACK=1
OTX_DAYS_BACK=1

# Minimum CVSS score to include (0–10); 7.0 = high+
MIN_CVSS_SCORE=7.0

# ─── Storage ───────────────────────────────────────────────────────────────────
DB_PATH=cyberthreat.db

# ─── Optional: Telegram monitoring ────────────────────────────────────────────
# Obtain via https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Comma-separated public channel usernames to monitor (no @)
TELEGRAM_CHANNELS=cybersecuritynews,darkwebinformer,vxunderground

# ─── Optional: GitHub token (raises rate limit for advisory API) ───────────────
GITHUB_TOKEN=
